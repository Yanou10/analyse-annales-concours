    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Deux formes acceptées : la notification S3 de MinIO, et un appel manuel.\n// La clé S3 est encodée en URL et les espaces y sont des « + » : la décoder\n// n'est pas une coquetterie, un sujet nommé « 2024 InfoA.md » arriverait sinon\n// sous le nom « 2024+InfoA.md » et le service ne le trouverait pas.\nconst entree = $json.body ?? $json;\nlet cle = null;\n\nif (Array.isArray(entree.Records) && entree.Records.length > 0) {\n  const brut = entree.Records[0]?.s3?.object?.key ?? null;\n  if (brut) cle = decodeURIComponent(String(brut).replace(/\\+/g, ' '));\n}\ncle = cle ?? entree.cle ?? entree.key ?? entree.objet ?? null;\n\nif (!cle) {\n  throw new Error(\n    \"aucune clé d'objet dans la charge utile : attendu Records[0].s3.object.key \" +\n    \"(événement MinIO) ou {\\\"cle\\\": \\\"2024_InfoA.md\\\"} (appel manuel)\"\n  );\n}\nif (!/\\.md$/i.test(cle)) {\n  throw new Error(\"seuls les sujets .md sont traités, reçu : \" + cle);\n}\n\nconst nom = cle.split('/').pop().replace(/\\.md$/i, '');\nconst horodatage = new Date().toISOString().replace(/[^0-9]/g, '').slice(0, 14);\n\nreturn [{ json: {\n  service: \"http://annales-service:8000\",\n  cle: cle,\n  lot: entree.lot ?? nom,\n  passe: entree.passe ?? (nom + '-' + horodatage),\n  referentiel_demande: entree.referentiel ?? null,\n  recu_le: new Date().toISOString(),\n}}];"
      },
      "id": "92db48ae-aeca-4b87-8b2b-bfe5cd2c028b",
      "name": "Normaliser l'événement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
