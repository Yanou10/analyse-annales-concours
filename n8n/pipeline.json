    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Le référentiel n'est plus un préalable du service : une instance neuve n'en\n// a aucun, et c'est un état légitime. Le workflow, lui, ne peut rien étiqueter\n// sans référentiel — il s'arrête ici plutôt qu'à mi-parcours.\nconst sante = $json;\nconst contexte = $(\"Normaliser l'événement\").first().json;\nconst disponibles = sante?.referentiels?.disponibles ?? [];\nconst demande = contexte.referentiel_demande;\n\nconst referentiel = (demande && disponibles.includes(demande))\n  ? demande\n  : (disponibles.length > 0 ? disponibles[0] : null);\n\nreturn [{ json: {\n  ...contexte,\n  sante_etat: sante?.etat ?? \"inconnu\",\n  disponibles: disponibles,\n  referentiel: referentiel,\n}}];"
      },
