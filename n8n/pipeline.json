      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        4840,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// L'étape qui a échoué est celle dont on vient : on lit la tâche courante,\n// pas une étape antérieure. Continuer sur une étape ratée produirait des\n// mesures sur un corpus incomplet, ce qui est pire que s'arrêter.\nconst tache = $json;\nconst contexte = $(\"Choisir le référentiel\").first().json;\nconst borne = tache.etat !== \"echec\" && tache.etat !== \"interrompu\";\n\nreturn [{ json: {\n  resultat: \"échoué\",\n  etape: tache.endpoint ?? \"inconnue\",\n  cause: borne ? \"borne d'itérations atteinte, tâche toujours en cours\"\n               : (tache.erreur ?? \"commande en échec\"),\n  etat_tache: tache.etat,\n  tache: tache.id,\n  code_retour: tache.code_retour ?? null,\n  sujet: contexte.cle,\n  passe: contexte.passe,\n  referentiel: contexte.referentiel,\n  stderr: (tache.stderr ?? \"\").slice(-4000),\n}}];"
      },
      "id": "1b35a72a-c84b-4a09-8a7a-9b411bf132c1",
      "name": "Composer le rapport d'échec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4840,
        760
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ \"Pipeline interrompu à l'étape \" + $json.etape + \" — \" + $json.cause }}"
      },
      "id": "c51914a0-d0b1-45f6-8244-2ac9ae2d01c9",
      "name": "Arrêter en erreur",
      "type": "n8n-nodes-base.stopAndError",
