        "query": "INSERT INTO passes (id, signature, source, protocole)\nVALUES ($1, $2, $3, '{}'::jsonb)\nON CONFLICT (id) DO UPDATE\n  SET signature = EXCLUDED.signature, source = EXCLUDED.source;",
