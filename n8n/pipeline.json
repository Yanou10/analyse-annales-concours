    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// La mesure est du TEXTE : l'étage 4 rend des tableaux sur stdout, le service\n// ne les dépose pas dans MinIO. On les remonte tels quels.\nconst mesure = $(\"Vérifier la mesure\").first().json;\nconst etiquetage = $(\"Vérifier l'étiquetage\").first().json;\nconst extraction = $(\"Vérifier l'extraction\").first().json;\nconst importation = $(\"Vérifier l'import\").first().json;\nconst contexte = $(\"Choisir le référentiel\").first().json;\n\nreturn [{ json: {\n  resultat: \"réussi\",\n  sujet: contexte.cle,\n  lot: contexte.lot,\n  passe: contexte.passe,\n  referentiel: contexte.referentiel,\n  signature: etiquetage?.contexte?.signature ?? null,\n  documents_extraits: extraction?.resultat?.documents ?? null,\n  etiquettes: etiquetage?.resultat ?? null,\n  duree_totale_s: Math.round(\n    (extraction?.duree_s ?? 0) + (etiquetage?.duree_s ?? 0) + (mesure?.duree_s ?? 0)\n  ),\n  distribution: mesure?.stdout ?? \"\",\n  import_en_base: {\n    etat: importation?.etat ?? null,\n    code_retour: importation?.code_retour ?? null,\n    // `annales-import` récapitule les lignes écrites par table.\n    rapport: (importation?.stdout ?? \"\").trim(),\n  },\n}}];"
      },
      "id": "674db9f8-29ea-47f0-8132-6d818dae96f8",
