    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// On SIGNALE les sujets en attente, on ne les enchaîne pas : l'étiquetage se\n// paie, et le référentiel qui vient d'être construit mérite d'être regardé\n// avant qu'on mesure 2 000 questions contre lui.\nconst corpus = $json;\nconst tache = $(\"Vérifier la construction\").first().json;\nconst contexte = $(\"Référentiel déjà construit ?\").first().json;\nconst empreinte = tache?.resultat?.empreinte ?? null;\n\nconst enAttente = (corpus?.objets ?? [])\n  .map(o => o.cle)\n  .filter(c => /\\.md$/i.test(c));\n\nreturn [{ json: {\n  resultat: \"réussi\",\n  programme: contexte.cle,\n  forcee: contexte.forcer === true,\n  empreinte: empreinte,\n  notions: tache?.resultat?.notions ?? null,\n  signature_etiquetage: tache?.resultat?.signature_etiquetage ?? null,\n  prefixe: tache?.resultat?.prefixe ?? null,\n  duree_s: tache?.duree_s ?? null,\n  sujets_en_attente: enAttente.length,\n  sujets: enAttente.slice(0, 50),\n  prochaine_etape: enAttente.length === 0\n    ? \"déposer des sujets dans le seau `corpus` — leur dépôt déclenchera le \" +\n      \"workflow principal\"\n    : enAttente.length + \" sujet(s) déjà dans `corpus` : ils ne seront PAS \" +\n      \"traités automatiquement (leur dépôt est antérieur). Rejouer le webhook \" +\n      \"/traiter pour chacun, ou appeler /extraire puis /etiqueter avec la \" +\n      \"liste complète — le regroupement par combinaison de sections n'opère \" +\n      \"qu'à l'intérieur d'un même appel.\",\n}}];"
      },
      "id": "deadaba4-c6e1-4f20-b4fa-aef52ead1d74",
      "name": "Composer le compte rendu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {},
      "id": "94a39d59-4916-466e-ab16-72bf36be42b3",
      "name": "Notifier la réussite",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2420,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tache = $json;\nconst contexte = $(\"Référentiel déjà construit ?\").first().json;\nconst borne = tache.etat !== \"echec\" && tache.etat !== \"interrompu\";\n\nreturn [{ json: {\n  resultat: \"échoué\",\n  etape: \"construire\",\n  cause: borne ? \"borne d'itérations atteinte (20 min), tâche toujours en cours\"\n               : (tache.erreur ?? \"commande en échec\"),\n  etat_tache: tache.etat,\n  tache: tache.id,\n  code_retour: tache.code_retour ?? null,\n  programme: contexte.cle,\n  stderr: (tache.stderr ?? \"\").slice(-4000),\n}}];"
      },
      "id": "ebf0acd1-334d-4cd1-9265-6fe335f32053",
      "name": "Composer le rapport d'échec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
