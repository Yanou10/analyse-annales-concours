{
  "name": "Chaîne annales — construire un référentiel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "programme",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "738ec1f1-c51b-47f0-a7dd-4a4accdecdcd",
      "name": "Réception du programme",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "3b830de9-dfd0-430f-a065-aee12bfcdaf2"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Deux formes : la notification S3 de MinIO, et un appel manuel. La clé S3 est\n// encodée en URL et les espaces y sont des « + » — la décoder n'est pas une\n// coquetterie, le service ne trouverait pas « 2026+programme.md ».\nconst entree = $json.body ?? $json;\nlet cle = null;\n\nif (Array.isArray(entree.Records) && entree.Records.length > 0) {\n  const brut = entree.Records[0]?.s3?.object?.key ?? null;\n  if (brut) cle = decodeURIComponent(String(brut).replace(/\\+/g, ' '));\n}\ncle = cle ?? entree.cle ?? entree.key ?? entree.programme ?? null;\n\nif (!cle) {\n  throw new Error(\n    \"aucune clé d'objet : attendu Records[0].s3.object.key (événement MinIO) \" +\n    \"ou {\\\"cle\\\": \\\"programme.md\\\"} (appel manuel)\"\n  );\n}\nif (!/\\.md$/i.test(cle)) {\n  throw new Error(\"seuls les programmes .md sont traités, reçu : \" + cle);\n}\n\nreturn [{ json: {\n  service: \"http://annales-service:8000\",\n  cle: cle,\n  // La construction coûte ~3 $ en appels Opus : elle ne se déclenche pas sur\n  // un dépôt accidentel. `forcer` doit être explicite.\n  forcer: entree.forcer === true,\n  etag: entree.Records?.[0]?.s3?.object?.eTag ?? null,\n  recu_le: new Date().toISOString(),\n}}];"
      },
      "id": "1ba3a82b-cb48-497a-82bc-e0f93fee41c5",
      "name": "Normaliser l'événement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://annales-service:8000/referentiels",
        "options": {}
      },
      "id": "1fa390a7-540e-4c9b-880c-7def140707c5",
      "name": "Lister les référentiels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Garde-fou de dépense. Le rapprochement se fait sur la CLÉ de l'objet\n// programme, inscrite dans origine.json par le service : c'est la seule\n// information dont dispose le workflow — il ne télécharge pas le fichier et ne\n// peut donc pas en calculer l'empreinte de contenu.\n//\n// Conséquence à connaître : redéposer un programme CORRIGÉ sous le même nom est\n// bloqué lui aussi. C'est le bon défaut à 3 $ l'appel ; `forcer: true` passe\n// outre.\nconst contexte = $(\"Normaliser l'événement\").first().json;\nconst liste = $json?.referentiels ?? [];\nconst attendu = \"programmes/\" + contexte.cle;\n\nconst deja = liste.filter(r => (r?.origine?.programme ?? null) === attendu);\n\nreturn [{ json: {\n  ...contexte,\n  deja_construit: deja.length > 0,\n  empreintes_existantes: deja.map(r => r.empreinte),\n  referentiels_connus: liste.length,\n  reconstruire: contexte.forcer || deja.length === 0,\n}}];"
      },
      "id": "481e23ef-ce0f-4582-815c-d2b57a6fc59b",
      "name": "Référentiel déjà construit ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "294be027-1664-47c1-a503-85c9ce977a09",
              "leftValue": "={{ $json.reconstruire }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "27115160-4665-481c-86a2-ea6aab6d9728",
      "name": "Reconstruire ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $json;\nreturn [{ json: {\n  resultat: \"ignoré\",\n  raison: \"un référentiel a déjà été construit depuis ce programme\",\n  programme: c.cle,\n  empreintes_existantes: c.empreintes_existantes,\n  cout_evite_usd: 3,\n  pour_reconstruire:\n    \"redéposer avec {\\\"cle\\\": \\\"\" + c.cle + \"\\\", \\\"forcer\\\": true} \" +\n    \"sur le webhook /programme\",\n}}];"
      },
      "id": "9d722413-9215-4bce-a352-ebb43917214c",
      "name": "Notifier la dépense évitée",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        990,
