    {
      "parameters": {
        "method": "GET",
        "url": "http://annales-service:8000/objets?seau=corpus&limite=500",
        "options": {}
      },
      "id": "ef43d455-3fa4-4d2a-88a6-8fbc538866c7",
      "name": "Lister le corpus en attente",
      "type": "n8n-nodes-base.httpRequest",
