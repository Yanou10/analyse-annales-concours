# Copier en .env — aucun chemin n'est codé en dur dans le programme.

# --- Entrées / sorties ------------------------------------------------------
ETAGE0_RACINE=/app
ETAGE0_PROGRAMME=/app/data/spe777_annexe_1373646.md
ETAGE0_PROFIL=/app/profils/informatique-mpi.yaml
ETAGE0_SORTIE=/app/referentiel/genere
ETAGE0_JOURNAL=/app/.etage0/journal.jsonl
ETAGE0_VERSION=1.0.0

# Sections écrites à la main, servant d'étalon de mesure (facultatif)
ETAGE0_ETALON=/app/referentiel/v1/sections

# --- Fournisseur ------------------------------------------------------------
ETAGE0_FOURNISSEUR=anthropic        # anthropic | ollama
ETAGE0_MODELE=claude-opus-5
ETAGE0_EFFORT=high                  # low | medium | high | xhigh | max
ETAGE0_MAX_TOKENS=16000

# Repli serveur sur refus des classificateurs de sûreté.
# Laisser à 1 : un refus renvoie un HTTP 200 avec stop_reason="refusal" et,
# sans repli, la section est simplement perdue.
ETAGE0_FALLBACKS=1

# --- Anthropic --------------------------------------------------------------
# Facultatif si `ant auth login` a été fait : le SDK lit le profil OAuth.
ANTHROPIC_API_KEY=

# --- Ollama (itération locale gratuite avant la passe payante) --------------
OLLAMA_BASE_URL=http://ollama:11434
ETAGE0_MODELE_OLLAMA=qwen2.5:14b
