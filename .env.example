# Copier en `.env`, qui n'est jamais versionné.
# Aucune de ces valeurs ne transite par une requête HTTP : le service les lit
# dans son environnement, jamais dans un corps de requête.

# --- Modèle ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Doit refléter config/mesure.yaml : l'étage 3 refuse de tourner si
# l'environnement s'écarte du protocole figé.
ETAGE0_MODELE=claude-sonnet-5
ETAGE0_REFLEXION=0                  # thinking désactivé : seul levier de variance
ETAGE0_EFFORT=high                  # low | medium | high | xhigh | max
ETAGE0_MAX_TOKENS=16000
# temperature, top_p et top_k n'existent pas : les modèles courants les
# rejettent en 400. Il n'y a pas de bouton « déterminisme ».

# --- Chemins de l'étage 0 ----------------------------------------------------
ETAGE0_PROGRAMME=spe777_annexe_1373646.md
ETAGE0_PROFIL=profils/informatique-mpi.yaml
ETAGE0_SORTIE=referentiel/genere
ETAGE0_JOURNAL=.etage0/journal.jsonl   # reprise sur appels déjà payés

# --- Service HTTP ------------------------------------------------------------
SERVICE_TRAVAIL=/travail
SERVICE_NIVEAU_LOG=INFO

# --- MinIO -------------------------------------------------------------------
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SERVICE_SEAU_PROGRAMMES=programmes
SERVICE_SEAU_CORPUS=corpus
SERVICE_SEAU_SORTIES=sorties

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgresql://annales:...@postgres:5432/annales

# --- n8n ---------------------------------------------------------------------
# `mc admin config set` ignore SILENCIEUSEMENT `enable=on` : l'activation d'une
# cible webhook doit passer par l'environnement du conteneur MinIO.
MINIO_NOTIFY_WEBHOOK_ENABLE_n8n=on
MINIO_NOTIFY_WEBHOOK_ENDPOINT_n8n=https://exemple/webhook/traiter
MINIO_NOTIFY_WEBHOOK_ENABLE_n8n_programme=on
MINIO_NOTIFY_WEBHOOK_ENDPOINT_n8n_programme=https://exemple/webhook/programme
